Subject: [PATCH] Luminol experiment config for command block command execution


diff --git a/src/main/java/dev/bacteriawa/mint/config/modules/fixes/CommandBlockConfig.java b/src/main/java/dev/bacteriawa/mint/config/modules/fixes/CommandBlockConfig.java
new file mode 100644
index 0000000000000000000000000000000000000000..a6151ff344a4b8d4e5d1f99043a065809d5b7b60
--- /dev/null
+++ b/src/main/java/dev/bacteriawa/mint/config/modules/fixes/CommandBlockConfig.java
@@ -0,0 +1,11 @@
+package dev.bacteriawa.mint.config.modules.fixes;
+
+import dev.bacteriawa.mint.config.ConfigCategory;
+import dev.bacteriawa.mint.config.ConfigField;
+import dev.bacteriawa.mint.config.Configuration;
+
+@Configuration(name = "force_enable_command_block_execution", type = ConfigCategory.fixes)
+public class CommandBlockConfig {
+    @ConfigField(comment = "experiment config for command block command execution")
+    public static boolean enabled = false;
+}
\ No newline at end of file
diff --git a/src/main/java/net/minecraft/world/level/BaseCommandBlock.java b/src/main/java/net/minecraft/world/level/BaseCommandBlock.java
index ccf476d1ed22cf992e3cbca6a375d36f85a82fa8..ea9e9d65a7edc8cd6b66e137e056746dffb5fb0b 100644
--- a/src/main/java/net/minecraft/world/level/BaseCommandBlock.java
+++ b/src/main/java/net/minecraft/world/level/BaseCommandBlock.java
@@ -117,7 +117,7 @@ public abstract class BaseCommandBlock implements CommandSource {
     }
 
     public boolean performCommand(Level world) {
-        if (true) return false; // Folia - region threading
+        if (!dev.bacteriawa.mint.config.modules.fixes.CommandBlockConfig.enabled) return false; // Folia - region threading // Luminol
         if (!world.isClientSide && world.getGameTime() != this.lastExecution) {
             if ("Searge".equalsIgnoreCase(this.command)) {
                 this.lastOutput = Component.literal("#itzlipofutzli");
