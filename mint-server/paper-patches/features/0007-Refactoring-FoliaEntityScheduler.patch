+                return CancelledState.CANCELLED_BY_CALLER;
             }
+
+            // 尝试取消运行中的重复任务
+            if (state.compareAndSet(STATE_RUNNING, STATE_CANCELLED)) {
+                return isRepeatingTask() ?
+                        CancelledState.NEXT_RUNS_CANCELLED :
