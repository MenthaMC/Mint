+    private @Nullable ScheduledTask scheduleTask(final Plugin plugin, final Consumer<ScheduledTask> task,
+                                                 final Runnable retired, long delay, long period) {
         Validate.notNull(plugin, "Plugin may not be null");
         Validate.notNull(task, "Task may not be null");
-        if (initialDelayTicks <= 0) {
-            throw new IllegalArgumentException("Initial delay ticks may not be <= 0");
-        }
-        if (periodTicks <= 0) {
-            throw new IllegalArgumentException("Period ticks may not be <= 0");
+        if (delay <= 0 || period == 0) {
+            throw new IllegalArgumentException("Invalid delay/period");
         }
 
         if (!plugin.isEnabled()) {
-            throw new IllegalPluginAccessException("Plugin attempted to register task while disabled");
+            throw new IllegalPluginAccessException("Plugin disabled");
         }
 
-        final EntityScheduledTask ret = new EntityScheduledTask(plugin, periodTicks, task, retired);
+        final EntityScheduledTask scheduledTask = new EntityScheduledTask(
+                plugin, task, retired, period
+        );
 
-        if (!this.scheduleInternal(ret, initialDelayTicks)) {
+        if (!this.entity.taskScheduler.schedule(scheduledTask, scheduledTask, delay)) {
+            scheduledTask.cleanup(); // 立即清理无法调度的任务
             return null;
         }
 
-        if (!plugin.isEnabled()) {
-            // handle race condition where plugin is disabled asynchronously
-            ret.cancel();
-        }
-
-        return ret;
+        return scheduledTask;
