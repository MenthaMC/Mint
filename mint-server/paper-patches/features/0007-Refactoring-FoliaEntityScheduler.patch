-                } else if (retired || !this.plugin.isEnabled()) {
-                     this.setStateVolatile(STATE_CANCELLED);
-                } else if (STATE_EXECUTING == this.compareAndExchangeStateVolatile(STATE_EXECUTING, STATE_IDLE)) {
-                    reschedule = true;
