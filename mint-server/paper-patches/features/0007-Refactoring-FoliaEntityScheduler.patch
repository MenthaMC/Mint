+        }
+
+        private void executeTask() {
+            if (task != null) {
+                task.accept(this);
+            }
+        }
+
+        private void handleRetired() {
+            if (retiredCallback != null) {
+                retiredCallback.run();
+            }
+        }
+
+        private void handlePostExecution(boolean entityRetired) {
+            // 实体退役或非重复任务：标记完成
+            if (entityRetired || periodTicks <= 0) {
+                state.set(periodTicks > 0 ? STATE_CANCELLED : STATE_COMPLETED);
+                cleanup();
+                return;
+            }
+
+            // 重新调度重复任务
+            if (state.compareAndSet(STATE_RUNNING, STATE_SCHEDULED)) {
+                if (!FoliaEntityScheduler.this.entity.taskScheduler.schedule(this, this, periodTicks)) {
+                    state.set(STATE_CANCELLED);
+                    cleanup();
                 }
+            } else { // 执行中被取消
+                cleanup();
             }
         }
 
+        void cleanup() {
+            task = null;
+            retiredCallback = null;
+        }
