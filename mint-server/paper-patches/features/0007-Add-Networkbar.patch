From: Bacteriawa <A3167717663@hotmail.com>
Date: Tue, 5 May 2026 01:15:22 +0800
Subject: [PATCH] Add Networkbar


diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
index 8e526f8d0ddcefb8eabb563e820ea518f18f2f50..5edcc209b7a0661fdb2a895c56d9907409c36c7c 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
@@ -2208,6 +2208,9 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
             //Luminol start - Regionbar
             getHandle().isRegionBarVisible = data.getBooleanOr("regionbarVisible", false);
             //Luminol end
+            // Mint start - Networkbar
+            getHandle().isNetworkBarVisible = data.getBooleanOr("networkbarVisible", false);
+            // Mint end - Networkbar
         });
     }
 
@@ -2234,6 +2237,9 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
         //Luminol start - Regionbar
         data.putBoolean("regionbarVisible", handle.isRegionBarVisible);
         //Luminol end
+        // Mint start - Networkbar
+        data.putBoolean("networkbarVisible", handle.isNetworkBarVisible);
+        // Mint end - Networkbar
 
         // Paper start - persist for use in offline save data
         ValueOutput paper = output.child("Paper");
