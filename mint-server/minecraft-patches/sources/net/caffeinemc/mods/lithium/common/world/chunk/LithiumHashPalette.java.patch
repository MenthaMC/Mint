+package net.caffeinemc.mods.lithium.common.world.chunk;
+
+import ca.spottedleaf.moonrise.patches.fast_palette.FastPaletteData;
+import net.minecraft.core.IdMap;
+import net.minecraft.network.FriendlyByteBuf;
+import net.minecraft.network.VarInt;
+import net.minecraft.util.CrudeIncrementalIntIdentityHashBiMap;
+import net.minecraft.world.level.chunk.HashMapPalette;
+import net.minecraft.world.level.chunk.Palette;
+import net.minecraft.world.level.chunk.PaletteResize;
+
+import java.util.List;
+
+/**
+ * Lithium: faster hash palette
+ * <p>
+ * Based on: "net/caffeinemc/mods/lithium/mixin/chunk/palette/StrategyMixin.java"
+ * By: 2No2Name <2No2Name@web.de>
+ * From: Lithium (https://github.com/CaffeineMC/lithium)
+ * Licensed under: LGPL-3.0-only (https://www.gnu.org/licenses/lgpl-3.0.html)
+ * <p>
+ * Uses identity-hash-based lookup instead of the default HashMap to avoid boxing overhead
+ * and improve cache performance for small palette sizes (3-8 bits).
+ */
+public class LithiumHashPalette<T> extends HashMapPalette<T> {
+
+    private static final int IDENTITY_HASH_SIZE_MULTIPLIER = 4;
+
+    // Identity hash map: parallel arrays for keys and values
+    private Object[] keys;
+    private int[] vals;
+    private final int bits;
+    private int size;
+    // Fallback to the parent's CrudeIncrementalIntIdentityHashBiMap when the identity map is full
+    private boolean useFallback;
+
+    private LithiumHashPalette(int bits) {
+        super(bits, true); // pass dummy = true to avoid allocating the BiMap in super
+        this.bits = bits;
+        int capacity = (1 << bits) * IDENTITY_HASH_SIZE_MULTIPLIER;
+        this.keys = new Object[capacity];
+        this.vals = new int[capacity];
+        this.size = 0;
+        this.useFallback = false;
+    }
+
+    public static <A> Palette<A> create(int bits, List<A> paletteEntries) {
+        LithiumHashPalette<A> palette = new LithiumHashPalette<>(bits);
+        for (A entry : paletteEntries) {
+            palette.idForInternal(entry, null);
+        }
+        return palette;
+    }
+
+    private int getIndex(Object key) {
+        int hash = System.identityHashCode(key);
+        int mask = this.keys.length - 1;
+        int idx = hash & mask;
+        while (true) {
+            Object existing = this.keys[idx];
+            if (existing == null || existing == key) {
+                return idx;
+            }
+            idx = (idx + 1) & mask;
+        }
+    }
+
+    @SuppressWarnings("unchecked")
+    private int idForInternal(T value, PaletteResize<T> resizeHandler) {
+        if (this.useFallback) {
+            return super.idFor(value, resizeHandler);
+        }
+
+        int idx = getIndex(value);
+        if (this.keys[idx] == value) {
+            return this.vals[idx];
+        }
+
+        // Not found - need to insert
+        int maxSize = 1 << this.bits;
+        if (this.size >= maxSize) {
+            if (resizeHandler != null) {
+                return resizeHandler.onResize(this.bits + 1, value);
+            }
+            // Fallback path: shouldn't happen during deserialization
+            return -1;
+        }
+
+        // Check load factor - rehash if needed
+        if (this.size * IDENTITY_HASH_SIZE_MULTIPLIER >= this.keys.length) {
+            // Rebuild with larger array
+            Object[] oldKeys = this.keys;
+            int[] oldVals = this.vals;
+            int newCap = this.keys.length * 2;
+            this.keys = new Object[newCap];
+            this.vals = new int[newCap];
+            for (int i = 0; i < oldKeys.length; i++) {
+                if (oldKeys[i] != null) {
+                    int newIdx = getIndex(oldKeys[i]);
+                    this.keys[newIdx] = oldKeys[i];
+                    this.vals[newIdx] = oldVals[i];
+                }
+            }
+            idx = getIndex(value);
+        }
+
+        int newId = this.size++;
+        this.keys[idx] = value;
+        this.vals[idx] = newId;
+        return newId;
+    }
+
+    @Override
+    public int idFor(T value, PaletteResize<T> resizeHandler) {
+        return this.idForInternal(value, resizeHandler);
+    }
+
+    @Override
+    @SuppressWarnings("unchecked")
+    public T valueFor(int index) {
+        if (this.useFallback) {
+            return super.valueFor(index);
+        }
+        for (int i = 0; i < this.keys.length; i++) {
+            if (this.keys[i] != null && this.vals[i] == index) {
+                return (T) this.keys[i];
+            }
+        }
+        throw new net.minecraft.world.level.chunk.MissingPaletteEntryException(index);
+    }
+
+    @Override
+    public int getSize() {
+        if (this.useFallback) {
+            return super.getSize();
+        }
+        return this.size;
+    }
+
+    @Override
+    public void read(FriendlyByteBuf buffer, IdMap<T> globalMap) {
+        if (this.useFallback) {
+            super.read(buffer, globalMap);
+            return;
+        }
+        this.keys = new Object[this.keys.length];
+        this.vals = new int[this.vals.length];
+        this.size = 0;
+        int count = buffer.readVarInt();
+        for (int i = 0; i < count; i++) {
+            T entry = globalMap.byIdOrThrow(buffer.readVarInt());
+            idForInternal(entry, null);
+        }
+    }
+
+    @Override
+    public void write(FriendlyByteBuf buffer, IdMap<T> globalMap) {
+        if (this.useFallback) {
+            super.write(buffer, globalMap);
+            return;
+        }
+        buffer.writeVarInt(this.size);
+        // Write entries in insertion order (by id)
+        @SuppressWarnings("unchecked")
+        T[] ordered = (T[]) new Object[this.size];
+        for (int i = 0; i < this.keys.length; i++) {
+            if (this.keys[i] != null) {
+                ordered[this.vals[i]] = (T) this.keys[i];
+            }
+        }
+        for (T entry : ordered) {
+            buffer.writeVarInt(globalMap.getId(entry));
+        }
+    }
+
+    @Override
+    public int getSerializedSize(IdMap<T> globalMap) {
+        if (this.useFallback) {
+            return super.getSerializedSize(globalMap);
+        }
+        @SuppressWarnings("unchecked")
+        T[] ordered = (T[]) new Object[this.size];
+        for (int i = 0; i < this.keys.length; i++) {
+            if (this.keys[i] != null) {
+                ordered[this.vals[i]] = (T) this.keys[i];
+            }
+        }
+        int totalSize = VarInt.getByteSize(this.size);
+        for (T entry : ordered) {
+            totalSize += VarInt.getByteSize(globalMap.getId(entry));
+        }
+        return totalSize;
+    }
+
+    @Override
+    public Palette<T> copy() {
+        LithiumHashPalette<T> copy = new LithiumHashPalette<>(this.bits);
+        copy.keys = this.keys.clone();
+        copy.vals = this.vals.clone();
+        copy.size = this.size;
+        copy.useFallback = this.useFallback;
+        return copy;
+    }
+
+    @Override
+    @SuppressWarnings("unchecked")
+    public T[] moonrise$getRawPalette(FastPaletteData<T> container) {
+        if (this.useFallback) {
+            return super.moonrise$getRawPalette(container);
+        }
+        // Build ordered array by id for moonrise fast-palette compatibility
+        T[] ordered = (T[]) new Object[this.size];
+        for (int i = 0; i < this.keys.length; i++) {
+            if (this.keys[i] != null) {
+                ordered[this.vals[i]] = (T) this.keys[i];
+            }
+        }
+        return ordered;
+    }
+}
