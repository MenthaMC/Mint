+    private void reconcileConnection(ServerPlayer player, WaypointTransmitter waypoint, boolean locatorBarEnabled) {
+        ConcurrentMap<WaypointTransmitter, WaypointTransmitter.Connection> connectionMap = this.connections.get(player);
+        if (connectionMap == null) {
+            if (!this.players.contains(player)) {
+                return;
             }
+
+            ConcurrentMap<WaypointTransmitter, WaypointTransmitter.Connection> newConnectionMap = new ConcurrentHashMap<>();
+            ConcurrentMap<WaypointTransmitter, WaypointTransmitter.Connection> previous = this.connections.putIfAbsent(player, newConnectionMap);
+            connectionMap = previous != null ? previous : newConnectionMap;
         }
-    }
 
-    private void updateConnection(final ServerPlayer player, final WaypointTransmitter waypoint, final WaypointTransmitter.Connection connection) {
-        if (player != waypoint) {
-            if (isLocatorBarEnabledFor(player)) {
+        // Mint start - Folia-safe waypoint connection hotpath
+        // Keep updates/removals per player-waypoint serialized, replacing split create/update paths.
+        connectionMap.compute(waypoint, (ignored, connection) -> {
+            boolean tracked = player != waypoint && locatorBarEnabled && this.players.contains(player) && this.waypoints.contains(waypoint);
+            if (!tracked) {
+                if (connection != null) {
+                    connection.disconnect();
+                }
+                return null;
+            }
+
+            if (connection != null) {
                 if (!connection.isBroken()) {
                     connection.update();
-                } else {
-                    waypoint.makeWaypointConnectionWith(player).ifPresentOrElse(newConnection -> {
-                        newConnection.connect();
-                        this.connections.put(player, waypoint, newConnection);
-                    }, () -> {
-                        connection.disconnect();
-                        this.connections.remove(player, waypoint);
-                    });
+                    return connection;
                 }
+
+                connection.disconnect();
+            }
+
+            WaypointTransmitter.Connection newConnection = waypoint.makeWaypointConnectionWith(player).orElse(null);
+            if (newConnection == null) {
+                return null;
             }
+
+            newConnection.connect();
+            return newConnection;
+        });
+        // Mint end - Folia-safe waypoint connection hotpath
+    }
