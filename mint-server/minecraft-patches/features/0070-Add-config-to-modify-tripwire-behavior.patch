From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bacteriawa <A3167717663@hotmail.com>
Date: Thu, 23 Apr 2026 02:00:03 +0800
Subject: [PATCH] Add config to modify tripwire behavior


diff --git a/net/minecraft/world/level/block/TripWireHookBlock.java b/net/minecraft/world/level/block/TripWireHookBlock.java
index e7f0fbd95ac4fd639220dc3d032c2c62d91ad3a4..6794449f2b866b157b0ef3648ea01ba97a32d896 100644
--- a/net/minecraft/world/level/block/TripWireHookBlock.java
+++ b/net/minecraft/world/level/block/TripWireHookBlock.java
@@ -211,10 +211,17 @@ public class TripWireHookBlock extends Block {
                     BlockPos testPosx = pos.relative(direction, i);
                     BlockState wireData = wireStates[i];
                     if (wireData != null) {
-                        BlockState testPosState = level.getBlockState(testPosx);
-                        if (testPosState.is(Blocks.TRIPWIRE) || testPosState.is(Blocks.TRIPWIRE_HOOK)) {
-                            if (dev.bacteriawa.mint.config.modules.fixes.VanillaLikeExperienceConfig.enabled || !io.papermc.paper.configuration.GlobalConfiguration.get().blockUpdates.disableTripwireUpdates || !testPosState.is(Blocks.TRIPWIRE)) level.setBlock(testPosx, wireData.trySetValue(ATTACHED, attached), Block.UPDATE_ALL); // Paper - prevent tripwire from updating // Mint - Vanilla-like experience
+                        // Mint start - tripwire and tripwireHook dupe
+                        if (dev.bacteriawa.mint.config.modules.fixes.AllowTripwireDupeConfig.enabled) {
+                            level.setBlock(testPosx, wireData.trySetValue(ATTACHED, attached), 3);
+                            level.getBlockState(testPosx);
+                        } else {
+                            BlockState testPosState = level.getBlockState(testPosx);
+                            if (testPosState.is(Blocks.TRIPWIRE) || testPosState.is(Blocks.TRIPWIRE_HOOK)) {
+                                if (dev.bacteriawa.mint.config.modules.fixes.VanillaLikeExperienceConfig.enabled || !io.papermc.paper.configuration.GlobalConfiguration.get().blockUpdates.disableTripwireUpdates || !testPosState.is(Blocks.TRIPWIRE)) level.setBlock(testPosx, wireData.trySetValue(ATTACHED, attached), Block.UPDATE_ALL); // Paper - prevent tripwire from updating // Mint - Vanilla-like experience
+                            }
                         }
+                        // Mint end - tripwire and tripwireHook dupe
                     }
                 }
             }
diff --git a/net/minecraft/world/level/levelgen/feature/EndPlatformFeature.java b/net/minecraft/world/level/levelgen/feature/EndPlatformFeature.java
index b67f5f7b76037ab77548c37a83e4d0918915223a..7f98830d3faf482f7cb56c2d921a2ff829b1f0f8 100644
--- a/net/minecraft/world/level/levelgen/feature/EndPlatformFeature.java
+++ b/net/minecraft/world/level/levelgen/feature/EndPlatformFeature.java
@@ -28,6 +28,11 @@ public class EndPlatformFeature extends Feature<NoneFeatureConfiguration> {
         // CraftBukkit end
         BlockPos.MutableBlockPos pos = origin.mutable();
 
+        // Mint start - tripwire behavior modifier
+        java.util.List<BlockPos> blockList1 = new java.util.ArrayList<>();
+        java.util.List<BlockPos> blockList2 = new java.util.ArrayList<>();
+        boolean flag21 = dev.bacteriawa.mint.config.modules.fixes.AllowTripwireDupeConfig.behaviorMode == dev.bacteriawa.mint.enums.EnumTripwireBehavior.VANILLA21;
+
         for (int dz = -2; dz <= 2; dz++) {
             for (int dx = -2; dx <= 2; dx++) {
                 for (int dy = -1; dy < 3; dy++) {
@@ -35,7 +40,29 @@ public class EndPlatformFeature extends Feature<NoneFeatureConfiguration> {
                     Block block = dy == -1 ? Blocks.OBSIDIAN : Blocks.AIR;
                     if (!blockList.getBlockState(blockPos).is(block)) { // CraftBukkit
                         if (dropResources) {
-                            blockList.destroyBlock(blockPos, true, null); // CraftBukkit
+                            boolean flag = false;
+                            if (dev.bacteriawa.mint.config.modules.fixes.AllowTripwireDupeConfig.enabled) {
+                                switch (dev.bacteriawa.mint.config.modules.fixes.AllowTripwireDupeConfig.behaviorMode) {
+                                    case dev.bacteriawa.mint.enums.EnumTripwireBehavior.VANILLA20: {
+                                        flag = true;
+                                    }
+                                    case dev.bacteriawa.mint.enums.EnumTripwireBehavior.MIXED: {
+                                        net.minecraft.world.level.block.state.BlockState state = newLevel.getBlockState(blockPos);
+                                        if (state.is(Blocks.TRIPWIRE)) {
+                                            if (state.getValue(net.minecraft.world.level.block.TripWireBlock.DISARMED)) {
+                                                flag = true;
+                                                blockList2.add(blockPos.immutable());
+                                            }
+                                            if (!flag) {
+                                                flag = checkString(blockList2, blockPos);
+                                            }
+                                        }
+                                    }
+                                    default: {} // Mint - 1.21 & default Logic - default empty
+                                }
+                            }
+                            if (flag) blockList1.add(blockPos.immutable());
+                            else blockList.destroyBlock(blockPos, true, null); // CraftBukkit
                         }
 
                         blockList.setBlock(blockPos, block.defaultBlockState(), Block.UPDATE_ALL); // CraftBukkit
@@ -53,11 +80,30 @@ public class EndPlatformFeature extends Feature<NoneFeatureConfiguration> {
             if (portalEvent.isCancelled()) return;
         }
 
-        if (dropResources) {
-            blockList.placeBlocks(state -> newLevel.destroyBlock(state.getPosition(), true, null));
+        if (flag21 || !dev.bacteriawa.mint.config.modules.fixes.AllowTripwireDupeConfig.enabled) {
+            if (dropResources) {
+                blockList.placeBlocks(state -> newLevel.destroyBlock(state.getPosition(), true, null));
+            } else {
+                blockList.placeBlocks();
+            }
         } else {
+            if (dropResources) {
+                blockList.getSnapshotBlocks().forEach((state) -> {
+                    newLevel.destroyBlock(state.getPosition(), !blockList1.contains(state.getPosition()), null);
+                });
+                // Mint - prevent tripwire dupe in end platform generate
+            }
             blockList.placeBlocks();
         }
         // CraftBukkit end
     }
+
+    private static boolean checkString(java.util.List<BlockPos> blockList, BlockPos blockPos) {
+        for (BlockPos pos : blockList) {
+            if (pos.getY() != blockPos.getY()) continue;
+            if (pos.getX() == blockPos.getX() || pos.getZ() == blockPos.getZ()) return true;
+        }
+        return false;
+    }
+    // Mint end - tripwire behavior modifier
 }
