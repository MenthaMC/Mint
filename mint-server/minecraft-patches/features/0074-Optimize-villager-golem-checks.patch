From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bacteriawa <A3167717663@hotmail.com>
Date: Thu, 23 Apr 2026 02:09:07 +0800
Subject: [PATCH] Optimize villager golem checks

Villager AI runs every tick at high entity counts. Replacing stream/optional
pipelines and minor repeated getters with tight loops reduces allocations and lets
hot paths short-circuit earlier without changing behavior.

diff --git a/net/minecraft/world/entity/npc/villager/Villager.java b/net/minecraft/world/entity/npc/villager/Villager.java
index 1369018cabb3a5bcfa9d04442ac3deba5998cbf0..a5f9f1afc959511d08bdaa9a7a85494570d9a99a 100644
--- a/net/minecraft/world/entity/npc/villager/Villager.java
+++ b/net/minecraft/world/entity/npc/villager/Villager.java
@@ -250,8 +250,9 @@ public class Villager extends AbstractVillager implements VillagerDataHolder, Re
     @Override
     public void inactiveTick() {
         // SPIGOT-3874, SPIGOT-3894, SPIGOT-3846, SPIGOT-5286 :(
-        if (this.getUnhappyCounter() > 0) {
-            this.setUnhappyCounter(this.getUnhappyCounter() - 1);
+        int unhappy = this.getUnhappyCounter();
+        if (unhappy > 0) {
+            this.setUnhappyCounter(unhappy - 1);
         }
         if (this.aware && this.isEffectiveAi()) { // Paper - Do not tick AI for inactive unaware mobs
             if (this.level().spigotConfig.tickInactiveVillagers) {
@@ -322,8 +323,9 @@ public class Villager extends AbstractVillager implements VillagerDataHolder, Re
     @Override
     public void tick() {
         super.tick();
-        if (this.getUnhappyCounter() > 0) {
-            this.setUnhappyCounter(this.getUnhappyCounter() - 1);
+        int unhappy = this.getUnhappyCounter();
+        if (unhappy > 0) {
+            this.setUnhappyCounter(unhappy - 1);
         }
 
         this.maybeDecayGossip();
@@ -914,11 +916,13 @@ public class Villager extends AbstractVillager implements VillagerDataHolder, Re
         if (this.wantsToSpawnGolem(timestamp)) {
             AABB villagerSearchBox = this.getBoundingBox().inflate(10.0, 10.0, 10.0);
             List<Villager> nearbyVillagers = level.getEntitiesOfClass(Villager.class, villagerSearchBox);
-            List<Villager> nearbyVillagersThatWantAGolem = nearbyVillagers.stream()
-                .filter(villager -> villager.wantsToSpawnGolem(timestamp))
-                .limit(5L)
-                .toList();
-            if (nearbyVillagersThatWantAGolem.size() >= villagersNeededToAgree) {
+            int remaining = villagersNeededToAgree;
+            for (int i = 0, size = nearbyVillagers.size(); i < size && remaining > 0; i++) {
+                if (nearbyVillagers.get(i).wantsToSpawnGolem(timestamp)) {
+                    remaining--;
+                }
+            }
+            if (remaining <= 0) {
                 if (SpawnUtil.trySpawnMob( // Paper - Set Golem Last Seen to stop it from spawning another one - switch to isPresent
                         EntityType.IRON_GOLEM,
                         EntitySpawnReason.MOB_SUMMONED,
@@ -940,7 +944,7 @@ public class Villager extends AbstractVillager implements VillagerDataHolder, Re
     }
 
     public boolean wantsToSpawnGolem(final long timestamp) {
-        return this.golemSpawnConditionsMet(this.level().getGameTime()) && !this.brain.hasMemoryValue(MemoryModuleType.GOLEM_DETECTED_RECENTLY);
+        return this.golemSpawnConditionsMet(timestamp) && !this.brain.hasMemoryValue(MemoryModuleType.GOLEM_DETECTED_RECENTLY);
     }
 
     @Override
@@ -986,8 +990,8 @@ public class Villager extends AbstractVillager implements VillagerDataHolder, Re
     }
 
     private boolean golemSpawnConditionsMet(final long gameTime) {
-        Optional<Long> sleepMemory = this.brain.getMemory(MemoryModuleType.LAST_SLEPT);
-        return sleepMemory.filter(aLong -> gameTime - aLong < 24000L).isPresent();
+        Optional<Long> lastSlept = this.brain.getMemory(MemoryModuleType.LAST_SLEPT);
+        return lastSlept.isPresent() && gameTime - lastSlept.get() < 24000L;
     }
 
     @Override
