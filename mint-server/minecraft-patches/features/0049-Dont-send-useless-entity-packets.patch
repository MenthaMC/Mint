                     flag4 = true;
                 }
 
+                if (dev.bacteriawa.mint.config.modules.optimizations.ReduceUselessPacketsConfig.reduceUselessEntityMovePackets && isUselessMoveEntityPacket(packet)) packet = null; // Purpur
