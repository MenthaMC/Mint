         private boolean isConditionallyFullOpaque;
@@ -656,6 +657,7 @@ public abstract class BlockBehaviour implements FeatureElement {
                     initCaches(shape, true);
                 }
             }
+            this.tagFlag = cn.dreeam.leaf.util.BlockMasks.init(asState()); // Leaf - Cache block state tags
