diff --git a/net/minecraft/commands/Commands.java b/net/minecraft/commands/Commands.java
index c55c04e49069d8cbcc84aed0ff4f5747ae069531..f7bc9f2eef726a7166ab26b0a1c7e862838bf236 100644
