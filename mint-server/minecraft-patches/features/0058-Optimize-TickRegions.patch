From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bacteriawa <A3167717663@hotmail.com>
Date: Tue, 8 Jul 2025 17:59:07 +0800
Subject: [PATCH] Optimize TickRegions


diff --git a/io/papermc/paper/threadedregions/TickRegions.java b/io/papermc/paper/threadedregions/TickRegions.java
index 988fe74578065c9464f5639e5cc6af79619edef5..70e255a449ef4156f20ba506a22226c3946e1411 100644
--- a/io/papermc/paper/threadedregions/TickRegions.java
+++ b/io/papermc/paper/threadedregions/TickRegions.java
@@ -40,25 +40,36 @@ public final class TickRegions implements ThreadedRegionizer.RegionCallbacks<Tic
             return;
         }
         initialised = true;
-        int gridExponent = config.gridExponent;
-        gridExponent = Math.max(0, gridExponent);
-        gridExponent = Math.min(31, gridExponent);
+        // Mint - Start
+        // 区域大小配置优化
+        int gridExponent = Math.max(0, Math.min(31, config.gridExponent));
         regionShift = gridExponent;
 
+        // 动态线程计算优化
         int tickThreads;
         if (config.threads <= 0) {
-            tickThreads = Runtime.getRuntime().availableProcessors() / 2;
-            if (tickThreads <= 4) {
-                tickThreads = 1;
-            } else {
-                tickThreads =  tickThreads / 4;
-            }
+            int cores = Runtime.getRuntime().availableProcessors();
+            double factor = Math.min(0.3, 0.25 + (cores / 100.0)); // 自适应因子
+
+            // 基础线程数：核心数的50%，至少2线程
+            int baseThreads = Math.max(2, (int) Math.ceil(cores * 0.5));
+
+            // 应用对数缩放因子
+            tickThreads = (int) Math.ceil(baseThreads * factor);
+
+            // 边界保护
+            tickThreads = Math.max(2, Math.min(tickThreads, cores));
+
+            LOGGER.debug("Dynamic thread calculation: cores={}, factor={:.2f}, base={}, threads={}",
+                    cores, factor, baseThreads, tickThreads);
         } else {
             tickThreads = config.threads;
         }
 
         scheduler = new TickRegionScheduler(tickThreads);
-        LOGGER.info("Regionised ticking is enabled with " + tickThreads + " tick threads");
+        LOGGER.info("Regionised ticking enabled: threads={}, grid={} ({}x{} chunks per region)",
+                tickThreads, gridExponent, 1 << gridExponent, 1 << gridExponent);
+        // Mint - End
     }
 
     @Override
@@ -403,36 +414,59 @@ public final class TickRegions implements ThreadedRegionizer.RegionCallbacks<Tic
         @Override
         protected void tickRegion(final int tickCount, final long startTime, final long scheduledEnd) {
             final ca.spottedleaf.leafprofiler.RegionizedProfiler.Handle profiler = io.papermc.paper.threadedregions.TickRegionScheduler.getProfiler(); // Folia - profiler
-            profiler.startTick(); try { // Folia - profiler
-            MinecraftServer.getServer().tickServer(startTime, scheduledEnd, TimeUnit.MILLISECONDS.toMillis(10L), this.region);
-            } finally { profiler.stopTick(); } // Folia - profiler
+            // Mint - Start
+            try {
+                profiler.startTick();
+
+                // 动态时间分配
+                long timeBudget = TimeUnit.NANOSECONDS.toMicros(10);
+                long dynamicBudget = Math.min(timeBudget, (scheduledEnd - startTime) * 2);
+
+                MinecraftServer.getServer().tickServer(
+                        startTime,
+                        scheduledEnd,
+                        TimeUnit.MILLISECONDS.toMillis(dynamicBudget),
+                        this.region
+                );
+            } finally {
+                profiler.stopTick();
+            } // Folia - profiler // Mint - End
         }
 
         @Override
         protected boolean runRegionTasks(final BooleanSupplier canContinue) {
-            final ca.spottedleaf.leafprofiler.RegionizedProfiler.Handle profiler = io.papermc.paper.threadedregions.TickRegionScheduler.getProfiler(); // Folia start - profiler
-            profiler.startInBetweenTick(); try { // Folia - profiler
+            // Mint - Start
             final RegionizedTaskQueue.RegionTaskQueueData queue = this.region.taskQueueData;
+            boolean processedAny = false;
+
+            // 优先处理高优先级任务
+            for (int priority = 0; priority <3; priority++) {
+                boolean progress = false;
+                do {
+                    progress = false;
+                    if (canContinue.getAsBoolean()) {
+                        progress |= queue.executeTickTask();
+                    }
+                    if (canContinue.getAsBoolean()) {
+                        progress |= queue.executeChunkTask();
+                    }
+                    progress |= progress;
+                } while (progress && canContinue.getAsBoolean());
+            }
 
-            boolean processedChunkTask = false;
-
-            boolean executeChunkTask = true;
-            boolean executeTickTask = true;
-            do {
-                if (executeTickTask) {
-                    executeTickTask = queue.executeTickTask();
-                }
-                if (executeChunkTask) {
-                    processedChunkTask |= (executeChunkTask = queue.executeChunkTask());
-                }
-            } while ((executeChunkTask | executeTickTask) && canContinue.getAsBoolean());
+            // 处理普通任务
+            while (canContinue.getAsBoolean() && queue.executeTickTask()) {
+                processedAny = true;
+            }
 
-            if (processedChunkTask) {
-                // if we processed any chunk tasks, try to process ticket level updates for full status changes
-                this.region.world.moonrise$getChunkTaskScheduler().chunkHolderManager.processTicketUpdates();
+            // 更新区块状态
+            if (processedAny) {
+                this.region.world.moonrise$getChunkTaskScheduler()
+                        .chunkHolderManager.processTicketUpdates();
             }
-            return true;
-            } finally { profiler.stopInBetweenTick(); } // Folia - profiler
+
+            return processedAny;
+            // Mint - End
         }
 
         @Override
