+                    if (player != null) {
+                        // Game phase - track per player
+                        GlobalServerNetworkBar.updatePlayerNetworkData(player.getBukkitEntity(), 0, writtenBytes, 0, 1);
+                    } else {
+                        // Non-game phase (login, config, etc.) - track globally
+                        GlobalServerNetworkBar.updateGlobalNetworkData(0L, (long) writtenBytes, 0L, 1L);
                     }
-                } catch (Exception e) {
-                    // Silently ignore to prevent packet transmission issues
                 }
+            } catch (Exception e) {
+                // Silently ignore to prevent packet transmission issues
             }
             // Mint end
         } catch (Throwable var9) {
