diff --git a/net/minecraft/network/PacketDecoder.java b/net/minecraft/network/PacketDecoder.java
index 3dfe0b9dbaa40b3d2b3a1f38d359574a3fd2a220..586baed8a221af765a82ff5357c84666c48b3836 100644
--- a/net/minecraft/network/PacketDecoder.java
+++ b/net/minecraft/network/PacketDecoder.java
@@ -9,6 +9,7 @@ import java.util.List;
 import net.minecraft.network.protocol.Packet;
 import net.minecraft.network.protocol.PacketType;
 import dev.bacteriawa.mint.functions.NetworkAnalyser;
+import dev.bacteriawa.mint.functions.GlobalServerNetworkBar;
 import net.minecraft.util.profiling.jfr.JvmProfiler;
 import org.slf4j.Logger;
 
@@ -39,15 +40,28 @@ public class PacketDecoder<T extends PacketListener> extends ByteToMessageDecode
         JvmProfiler.INSTANCE.onPacketReceived(this.protocolInfo.id(), packetId, ctx.channel().remoteAddress(), readableBytes);
 
         // Mint start - Track received packets with accurate byte size
-        if (NetworkAnalyser.isRunning()) {
-            try {
-                Object handler = ctx.pipeline().get("packet_handler");
-                if (handler instanceof Connection) {
-                    NetworkAnalyser.onPacketReceived((Connection) handler, packet.getClass().getSimpleName(), readableBytes);
+        try {
+            Object handler = ctx.pipeline().get("packet_handler");
+            if (handler instanceof Connection) {
+                Connection connection = (Connection) handler;
+
+                // NetworkAnalyser tracking
+                if (NetworkAnalyser.isRunning()) {
+                    NetworkAnalyser.onPacketReceived(connection, packet.getClass().getSimpleName(), readableBytes);
+                }
+
+                // GlobalServerNetworkBar update - track all connections, not just game players
+                net.minecraft.server.level.ServerPlayer player = connection.getPlayer();
+                if (player != null) {
+                    // Game phase - track per player
+                    GlobalServerNetworkBar.updatePlayerNetworkData(player.getBukkitEntity(), readableBytes, 0, 1, 0);
+                } else {
+                    // Non-game phase (login, config, etc.) - track globally
+                    GlobalServerNetworkBar.updateGlobalNetworkData((long) readableBytes, 0L, 1L, 0L);
                 }
-            } catch (Exception e) {
-                // Silently ignore to prevent packet transmission issues
             }
+        } catch (Exception e) {
+            // Silently ignore to prevent packet transmission issues
         }
         // Mint end
         if (input.readableBytes() > 0) {
