+        net.minecraft.world.entity.LivingEntity target = null;
+        if (memory.isPresent()) {
+            List<net.minecraft.world.entity.LivingEntity> entities = memory.get();
+            for (int i = 0, size = entities.size(); i < size; i++) {
+                net.minecraft.world.entity.LivingEntity livingEntity = entities.get(i);
+                if (EntitySelector.NO_CREATIVE_OR_SPECTATOR.test(livingEntity)
+                    && Sensor.isEntityAttackable(level, entity, livingEntity)) {
+                    target = livingEntity;
+                    break;
+                }
+            }
+        }
+        if (target != null) {
+            entity.getBrain().setMemory(MemoryModuleType.NEAREST_ATTACKABLE, target);
+        } else {
+            entity.getBrain().eraseMemory(MemoryModuleType.NEAREST_ATTACKABLE);
