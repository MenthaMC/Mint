     @Override
     protected void doTick(ServerLevel level, Breeze entity) {
         super.doTick(level, entity);
-        entity.getBrain()
-            .getMemory(MemoryModuleType.NEAREST_LIVING_ENTITIES)
-            .stream()
-            .flatMap(Collection::stream)
-            .filter(EntitySelector.NO_CREATIVE_OR_SPECTATOR)
-            .filter(livingEntity -> Sensor.isEntityAttackable(level, entity, livingEntity))
-            .findFirst()
-            .ifPresentOrElse(
