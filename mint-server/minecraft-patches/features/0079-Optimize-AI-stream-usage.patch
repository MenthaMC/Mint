+            LivingEntity kid = kids.get(i);
+            if (!isChasingSomeone(kid)) {
+                continue;
+            }
+            LivingEntity target = whoAreYouChasing(kid);
+            map.put(target, map.getOrDefault(target, 0) + 1);
+        }
         return map;
