From: Bacteriawa <A3167717663@hotmail.com>
Date: Sat, 20 Dec 2025 02:10:46 +0800
Subject: [PATCH] Leaf Optimize LinearPalette MIME-Version: 1.0 Content-Type:
 text/plain; charset=UTF-8 Content-Transfer-Encoding: 8bit
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

getSerializedSize is 76% faster: 70.3ns 鈫?17.2ns
getSerializedSize.write is 13-21% faster: 659.5ns 鈫?523.1ns

Co-authored by: Taiyou06 <kaandindar21@gmail.com>
As part of: Leaf (https://github.com/Winds-Studio/Leaf/blob/ver/1.21.8/leaf-server/minecraft-patches/features/0198-Optimize-LinearPalette.patch)
Licensed under: MIT (https://github.com/Winds-Studio/Leaf/blob/ver/1.21.11/licenses/MIT.txt)

diff --git a/net/minecraft/world/level/chunk/LinearPalette.java b/net/minecraft/world/level/chunk/LinearPalette.java
index c93302f2457c71caae6f56c59d3a66357a0a6cd6..4033d449fa9e862bc3247e1efad5513641f6e165 100644
--- a/net/minecraft/world/level/chunk/LinearPalette.java
+++ b/net/minecraft/world/level/chunk/LinearPalette.java
@@ -11,6 +11,10 @@ public class LinearPalette<T> implements Palette<T>, ca.spottedleaf.moonrise.pat
     private final T[] values;
     private final int bits;
     private int size;
+    // Leaf start - Optimize LinearPalette
+    private final int[] byteSizes;
+    private final int[] idCache; // Cached registry IDs for values
+    // Leaf end - Optimize LinearPalette
 
     // Paper start - optimise palette reads
     @Override
@@ -21,20 +25,38 @@ public class LinearPalette<T> implements Palette<T>, ca.spottedleaf.moonrise.pat
 
     private LinearPalette(int bits, List<T> values) {
         this.values = (T[])(new Object[1 << bits]);
+        // Leaf start - Optimize LinearPalette
+        this.idCache = new int[1 << bits];
+        this.byteSizes = new int[1 << bits]; // Initialize byteSizes
+        // Leaf end - Optimize LinearPalette
         this.bits = bits;
         Validate.isTrue(values.size() <= this.values.length, "Can't initialize LinearPalette of size %d with %d entries", this.values.length, values.size());
 
         for (int i = 0; i < values.size(); i++) {
-            this.values[i] = values.get(i);
+            // Leaf start - Optimize LinearPalette
+            T value = values.get(i);
+            this.values[i] = value;
+            // Registry id / serialized byte size are lazily computed from the IdMap passed to write/getSerializedSize.
+            this.idCache[i] = -1;
+            this.byteSizes[i] = 0;
+            // Leaf end - Optimize LinearPalette
         }
 
         this.size = values.size();
     }
 
-    private LinearPalette(T[] values, int bits, int size) {
+    private LinearPalette(T[] values, int[] idCache, int bits, int size) {
         this.values = values;
         this.bits = bits;
         this.size = size;
+        this.idCache = idCache; // Leaf - Optimize LinearPalette
+        // Leaf start - Optimize LinearPalette
+        this.byteSizes = new int[idCache.length];
+        for (int i = 0; i < idCache.length; i++) {
+            int cachedId = idCache[i];
+            this.byteSizes[i] = cachedId >= 0 ? VarInt.getByteSize(cachedId) : 0;
+        }
+        // Leaf end - Optimize LinearPalette
     }
 
     public static <A> Palette<A> create(int bits, List<A> values) {
@@ -52,6 +74,11 @@ public class LinearPalette<T> implements Palette<T>, ca.spottedleaf.moonrise.pat
         int ix = this.size;
         if (ix < this.values.length) {
             this.values[ix] = state;
+            // Leaf start - Optimize LinearPalette
+            // Registry id / serialized byte size are lazily computed from the IdMap passed to write/getSerializedSize.
+            this.idCache[ix] = -1;
+            this.byteSizes[ix] = 0;
+            // Leaf end - Optimize LinearPalette
             this.size++;
             return ix;
         } else {
@@ -84,7 +111,12 @@ public class LinearPalette<T> implements Palette<T>, ca.spottedleaf.moonrise.pat
         this.size = buffer.readVarInt();
 
         for (int i = 0; i < this.size; i++) {
-            this.values[i] = map.byIdOrThrow(buffer.readVarInt());
+            // Leaf start - Optimize LinearPalette
+            int id = buffer.readVarInt();
+            this.values[i] = map.byIdOrThrow(id);
+            this.idCache[i] = id;
+            this.byteSizes[i] = VarInt.getByteSize(id); // Precompute during read
+            // Leaf end - Optimize LinearPalette
         }
     }
 
@@ -93,17 +125,36 @@ public class LinearPalette<T> implements Palette<T>, ca.spottedleaf.moonrise.pat
         buffer.writeVarInt(this.size);
 
         for (int i = 0; i < this.size; i++) {
-            buffer.writeVarInt(map.getId(this.values[i]));
+            // Leaf start - Optimize LinearPalette - Use cached ID (lazily computed)
+            int id = this.idCache[i];
+            if (id < 0) {
+                id = map.getId(this.values[i]);
+                this.idCache[i] = id;
+                this.byteSizes[i] = VarInt.getByteSize(id);
+            }
+            buffer.writeVarInt(id);
+            // Leaf end - Optimize LinearPalette - Use cached ID (lazily computed)
         }
     }
 
     @Override
     public int getSerializedSize(IdMap<T> map) {
-        int byteSize = VarInt.getByteSize(this.getSize());
-
-        for (int i = 0; i < this.getSize(); i++) {
-            byteSize += VarInt.getByteSize(map.getId(this.values[i]));
+        // Leaf start - Optimize LinearPalette
+        int byteSize = VarInt.getByteSize(this.size);
+        for (int i = 0; i < this.size; i++) {
+            int bytes = this.byteSizes[i];
+            if (bytes == 0) {
+                int id = this.idCache[i];
+                if (id < 0) {
+                    id = map.getId(this.values[i]);
+                    this.idCache[i] = id;
+                }
+                bytes = VarInt.getByteSize(id);
+                this.byteSizes[i] = bytes;
+            }
+            byteSize += bytes;
         }
+        // Leaf end - Optimize LinearPalette
 
         return byteSize;
     }
@@ -115,6 +166,6 @@ public class LinearPalette<T> implements Palette<T>, ca.spottedleaf.moonrise.pat
 
     @Override
     public Palette<T> copy() {
-        return new LinearPalette<>((T[])((Object[])this.values.clone()), this.bits, this.size);
+        return new LinearPalette<>((T[])((Object[])this.values.clone()), this.idCache.clone(), this.bits, this.size); // Leaf - Optimize LinearPalette - copy cached ids
     }
 }
