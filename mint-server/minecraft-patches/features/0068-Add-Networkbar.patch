+import static dev.bacteriawa.mint.functions.GlobalServerNetworkBar.updatePlayerNetworkData;
+
 public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
     private static final float AVERAGE_PACKETS_SMOOTHING = 0.75F;
     private static final Logger LOGGER = LogUtils.getLogger();
@@ -327,6 +329,12 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
                 // Paper end - packet limiter
                 if (packetListener.shouldHandleMessage(packet)) {
                     try {
+                        // Mint start - Update player network data for received packets
+                        net.minecraft.server.level.ServerPlayer player = this.getPlayer();
+                        if (player != null) {
+                            updatePlayerNetworkData(player.getBukkitEntity(), packet.toString().length(), 0, 1, 0);
+                        }
+                        // Mint end - Update player network data for received packets
                         genericsFtw(packet, packetListener);
                     } catch (RunningOnDifferentThreadException var5) {
                     } catch (io.papermc.paper.util.ServerStopRejectedExecutionException ignored) { // Paper - do not prematurely disconnect players on stop
@@ -522,6 +530,11 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
             return;
         }
         try {
+        // Mint start - Update player network data for sent packets
+        if (player != null) {
+            updatePlayerNetworkData(player.getBukkitEntity(), 0, packet.toString().length(), 0, 1);
+        }
+        // Mint end - Update player network data for sent packets
         final ChannelFuture channelFuture;
         // Paper end - Optimize network
         if (channelFutureListener != null) {
