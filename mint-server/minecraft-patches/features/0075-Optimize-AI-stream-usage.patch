From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bacteriawa <A3167717663@hotmail.com>
Date: Thu, 23 Apr 2026 02:34:50 +0800
Subject: [PATCH] Optimize AI stream usage

AI sensors/behaviors run every tick across many entities. Replacing
stream pipelines with tight loops reduces allocations and iterator overhead while
preserving vanilla behavior and enabling cheap early exits.

diff --git a/net/minecraft/world/entity/ai/behavior/GateBehavior.java b/net/minecraft/world/entity/ai/behavior/GateBehavior.java
index 9fb025b05cacc901d72d93c16cf2b7e48d4dd9a6..6518b0b56a50d46bc1924fa1bc8eb1f3102a75ac 100644
--- a/net/minecraft/world/entity/ai/behavior/GateBehavior.java
+++ b/net/minecraft/world/entity/ai/behavior/GateBehavior.java
@@ -84,8 +84,15 @@ public class GateBehavior<E extends LivingEntity> implements BehaviorControl<E>
                 behavior.tickOrStop(level, body, timestamp);
             }
         }
+        boolean anyRunning = false;
+        for (final BehaviorControl<? super E> behavior : this.behaviors) {
+            if (behavior.getStatus() == Behavior.Status.RUNNING) {
+                anyRunning = true;
+                break;
+            }
+        }
         // Paper end - Perf: Remove streams from hot code
-        if (this.behaviors.stream().noneMatch(behavior -> behavior.getStatus() == Behavior.Status.RUNNING)) {
+        if (!anyRunning) {
             this.doStop(level, body, timestamp);
         }
     }
diff --git a/net/minecraft/world/entity/ai/behavior/InteractWithDoor.java b/net/minecraft/world/entity/ai/behavior/InteractWithDoor.java
