+++ b/net/minecraft/world/entity/ai/behavior/InteractWithDoor.java
@@ -136,12 +136,23 @@ public class InteractWithDoor {
     }
 
     private static boolean areOtherMobsComingThroughDoor(final LivingEntity body, final BlockPos doorPos, final Optional<List<LivingEntity>> nearestEntities) {
-        return !nearestEntities.isEmpty()
-            && nearestEntities.get()
-                .stream()
-                .filter(otherMob -> otherMob.getType() == body.getType())
-                .filter(otherMob -> doorPos.closerToCenterThan(otherMob.position(), MAX_DISTANCE_TO_HOLD_DOOR_OPEN_FOR_OTHER_MOBS))
-                .anyMatch(otherMob -> isMobComingThroughDoor(otherMob.getBrain(), doorPos));
+        if (nearestEntities.isEmpty()) {
+            return false;
+        }
+        List<LivingEntity> entities = nearestEntities.get();
+        for (int i = 0, size = entities.size(); i < size; i++) {
+            LivingEntity nearEntity = entities.get(i);
+            if (nearEntity.getType() != body.getType()) {
+                continue;
+            }
+            if (!doorPos.closerToCenterThan(nearEntity.position(), MAX_DISTANCE_TO_HOLD_DOOR_OPEN_FOR_OTHER_MOBS)) {
+                continue;
+            }
+            if (isMobComingThroughDoor(nearEntity.getBrain(), doorPos)) {
+                return true;
+            }
+        }
+        return false;
     }
 
     private static boolean isMobComingThroughDoor(final Brain<?> otherBrain, final BlockPos doorPos) {
