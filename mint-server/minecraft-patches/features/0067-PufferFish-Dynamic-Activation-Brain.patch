diff --git a/io/papermc/paper/entity/activation/ActivationRange.java b/io/papermc/paper/entity/activation/ActivationRange.java
index 7e5571f986bb739b6b39134507afa1b3dc0a29c8..97ac1e01b20196669573f22f8c10574fe8f30bb5 100644
--- a/io/papermc/paper/entity/activation/ActivationRange.java
+++ b/io/papermc/paper/entity/activation/ActivationRange.java
@@ -280,6 +280,15 @@ public final class ActivationRange {
             if (entity instanceof final Mob mob && mob.targetSelector.hasTasks()) {
                 return 0;
             }
+
+            // PufferFish DAB start
+            if (dev.bacteriawa.mint.config.modules.optimizations.DynamicActivationBrainConfig.enabled && entity.getType().dabEnabled) {
+                if (inactiveFor > dev.bacteriawa.mint.config.modules.optimizations.DynamicActivationBrainConfig.activationThreshold) {
+                    return 20;
+                }
+            }
+            // PufferFish DAB end
+
             if (entity instanceof final Pillager pillager) {
                 // TODO:?
             }
@@ -315,6 +324,16 @@ public final class ActivationRange {
         boolean isActive = entity.activatedTick >= io.papermc.paper.threadedregions.RegionizedServer.getCurrentTick(); // Folia - threaded regions
         entity.isTemporarilyActive = false;
 
+        // PufferFish DAB start
+        if (!isActive && entity.getType().dabEnabled) {
+            if (entity.activatedPriorityReset) {
+                entity.activatedPriorityReset = false;
+                entity.activatedPriority = dev.bacteriawa.mint.config.modules.optimizations.DynamicActivationBrainConfig.maximumActivationPrio;
+            }
+            isActive = (io.papermc.paper.threadedregions.RegionizedServer.getCurrentTick() + entity.getId()) % entity.activatedPriority == 0;
+        }
+        // PufferFish DAB end
+
         // Should this entity tick?
         if (!isActive) {
             if ((io.papermc.paper.threadedregions.RegionizedServer.getCurrentTick() - entity.activatedTick - 1) % 20 == 0) { // Folia - threaded regions
