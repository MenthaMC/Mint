diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
index 5d4310dab55cc960ccfce279e656e7b740f3d5c0..9fc9aed46d4b6f73c36786465f3965a73e4ffd0d 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -450,6 +450,30 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
     public boolean joining = true;
     public boolean sentListPacket = false;
     public boolean suppressTrackerForLogin = false; // Paper - Fire PlayerJoinEvent when Player is actually ready
+    // Mint start - Add tpsbar with chunkhot membar and regionbar
+    public boolean isTpsBarVisible = false;
+    public boolean isMemBarVisible = false;
+    public boolean isRegionBarVisible = false;
+    public long nearbyChunkHot = 0L;
+    public final long getNearbyChunkHot() { return this.nearbyChunkHot; }
+
+    public void refreshNearbyChunkHot() {
+        if (this.tickCount % 20 != 0) return;
+        long totalHot = 0L;
+        final int viewDistance = this.level().moonrise$getViewDistanceHolder().getViewDistances().tickViewDistance();
+        final int x = this.moonrise$getSectionX();
+        final int z = this.moonrise$getSectionZ();
+        for (int dx = -viewDistance; dx <= viewDistance; dx++) {
+            for (int dz = -viewDistance; dz <= viewDistance; dz++) {
+                net.minecraft.world.level.chunk.LevelChunk chunk = ((net.minecraft.server.level.ServerLevel)this.level()).getChunkIfLoaded(x + dx, z + dz);
+                if (chunk != null) {
+                    totalHot += chunk.getChunkHot().getAverage();
+                }
+            }
+        }
+        this.nearbyChunkHot = totalHot;
+    }
+    // Mint end
     // CraftBukkit end
     public boolean isRealPlayer; // Paper
     public com.destroystokyo.paper.event.entity.@Nullable PlayerNaturallySpawnCreaturesEvent playerNaturallySpawnedEvent; // Paper - PlayerNaturallySpawnCreaturesEvent
@@ -1084,8 +1108,8 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
                 this.oldLevel = this.experienceLevel;
             }
 
-            // Folia - region threading - move to main tick loop where we can detect duplicates
             // CraftBukkit end
+            this.refreshNearbyChunkHot(); // Mint - Add tpsbar with chunkhot membar and regionbar
         } catch (Throwable var4) {
             CrashReport report = CrashReport.forThrowable(var4, "Ticking player");
             CrashReportCategory category = report.addCategory("Player being ticked");
